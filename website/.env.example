# نموذج متغيرات البيئة للموقع
# -------------------------------------------------
# هذه المتغيرات يقرأها website/api/config.php عبر getenv().
# تُستخدم عند النشر على استضافة حقيقية، وتُضبط من لوحة الاستضافة
# أو عبر SetEnv في ملف .htaccess.
#
# للتشغيل المحلي على XAMPP لا تحتاجين هذا الملف،
# يكفي نسخ api/config.example.php إلى api/config.php.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rafqa_haramain
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME
